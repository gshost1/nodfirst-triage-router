# Nod First Triage Router - example environment. Placeholders only, no real secrets.
# Copy it to your own .env (`cp .env.example .env`) and fill in your values.
# .env is git-ignored: never commit, print, or share a real key.

# DigitalOcean Serverless Inference (OpenAI-compatible). Use `mock` for the
# offline canned client, which makes no network request.
LLM_BASE_URL=https://inference.do-ai.run/v1
LLM_API_KEY=doo-v1-REPLACE_ME                  # DO Model Access Key. Never commit the real .env
LLM_MODEL=router:nodfirst                      # used when ROUTER_MODE=do; or a concrete id from GET /v1/models

# Client-side fallback router tiers. IDs must come from GET /v1/models, never hardcoded in code.
MODEL_SMALL=your-small-model-id
MODEL_MID=your-mid-model-id
MODEL_LARGE=your-large-model-id

# do | client | mock   (mock = offline rehearsal; no provider calls)
ROUTER_MODE=mock

# Loopback port for the local app
PORT=8000

# Optional overrides
# LLM_REASONING_EFFORT=none        # sent on every real request; the GLM/Qwen tiers are thinking
#                                  # models and return empty text otherwise. Set to "" to omit it.
# DO_ROUTER_MODEL=router:nodfirst   # Inference Router name used by ROUTER_MODE=do
# CARE_DB=nodfirst.sqlite3          # SQLite store path (default: nodfirst.sqlite3, git-ignored)

# Optional: email every urgent alert to the sibling group through Botmail
# (https://botmail.pro). Leave ALERT_EMAIL_TO unset to keep alerts local.
# ALERT_EMAIL_TO=anna@example.com,pavel@example.com
# BOTMAIL_API_KEY=bm_REPLACE_ME                # or BOTMAIL_KEY_FILE=~/.botmail/key; never commit a real key

# Optional: inbound SMS/email webhook (POST /inbound). Map gateway senders to
# sibling names; unknown senders are shown by number/address, never as a sibling.
# INBOUND_CONTACTS=+15551234567=Anna,pavel@example.com=Pavel
# INBOUND_SECRET=REPLACE_ME            # required in the X-Inbound-Token header when set

# Optional: voice for "Read digest aloud" (DigitalOcean POST /v1/audio/speech,
# same endpoint and key as above; disabled automatically when LLM_BASE_URL=mock)
# TTS_MODEL=qwen3-tts-voicedesign
# TTS_VOICE=a warm, calm adult woman speaking clearly and slowly

# Local speech-to-text (whisper.cpp). All optional: the app finds whisper-cli
# and ffmpeg on PATH and the model at ~/.cache/whisper-cpp/ggml-base.en.bin.
# brew install whisper-cpp ffmpeg
# curl -L -o ~/.cache/whisper-cpp/ggml-base.en.bin \
#   https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
# STT_WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# STT_WHISPER_MODEL=~/.cache/whisper-cpp/ggml-base.en.bin
# STT_FFMPEG=/opt/homebrew/bin/ffmpeg
# STT_PROMPT=Mom, Anna, Pavel, metformin, lisinopril, cardiology
