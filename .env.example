# DigitalOcean Serverless Inference (OpenAI-compatible)
LLM_BASE_URL=https://inference.do-ai.run/v1
LLM_API_KEY=doo-v1-REPLACE_ME            # DO Model Access Key. Never commit the real .env
LLM_MODEL=router:nodfirst                 # used when ROUTER_MODE=do; or a concrete id from GET /v1/models

# Client-side fallback router tiers. Ids must come from GET /v1/models, never hardcoded in code.
MODEL_SMALL=your-small-model-id
MODEL_MID=your-mid-model-id
MODEL_LARGE=your-large-model-id

# do | client | mock
ROUTER_MODE=client
PORT=8000
